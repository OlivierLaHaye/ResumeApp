<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="CommonColor">#047af7</Color>
    <Color x:Key="CommonBlueColor">#047af7</Color>
    <Color x:Key="CommonGreenColor">#04D182</Color>
    <Color x:Key="CommonYellowColor">#f7e004</Color>
    <Color x:Key="CommonPurpleColor">#8B5CF6</Color>
    <Color x:Key="CommonOrangeColor">#F97316</Color>
    <Color x:Key="CommonCyanColor">#06B6D4</Color>
    <Color x:Key="CommonPinkColor">#EC4899</Color>
    <Color x:Key="CommonRedColor">#f70452</Color>

    <Color x:Key="CommonBlueStrongColor">#BFDBFE</Color>
    <Color x:Key="CommonGreenStrongColor">#BBF7D0</Color>
    <Color x:Key="CommonYellowStrongColor">#FEF08A</Color>
    <Color x:Key="CommonPurpleStrongColor">#DDD6FE</Color>
    <Color x:Key="CommonOrangeStrongColor">#FED7AA</Color>
    <Color x:Key="CommonCyanStrongColor">#A5F3FC</Color>
    <Color x:Key="CommonPinkStrongColor">#FBCFE8</Color>
    <Color x:Key="CommonRedStrongColor">#FECACA</Color>

    <Color x:Key="CommonBlueEdgeColor">#0057D6</Color>
    <Color x:Key="CommonGreenEdgeColor">#067A4C</Color>
    <Color x:Key="CommonYellowEdgeColor">#8A6A00</Color>
    <Color x:Key="CommonRedEdgeColor">#BE123C</Color>
    <Color x:Key="CommonPurpleEdgeColor">#6D28D9</Color>
    <Color x:Key="CommonOrangeEdgeColor">#C2410C</Color>
    <Color x:Key="CommonCyanEdgeColor">#0E7490</Color>
    <Color x:Key="CommonPinkEdgeColor">#BE185D</Color>

    <Color x:Key="CommonBlackColor">#F2F2F2</Color>
    <Color x:Key="CommonDarkerGrayColor">#FAFAFA</Color>
    <Color x:Key="CommonDarkGrayColor">#E6E6E6</Color>
    <Color x:Key="CommonGrayColor">#D5D5D5</Color>
    <Color x:Key="CommonLightGrayColor">#4D4D4D</Color>
    <Color x:Key="CommonWhiteColor">#121212</Color>

    <SolidColorBrush x:Key="CommonBlackBrush" Color="{DynamicResource CommonBlackColor}" />
    <SolidColorBrush x:Key="CommonDarkerGrayBrush" Color="{DynamicResource CommonDarkerGrayColor}" />
    <SolidColorBrush x:Key="CommonDarkGrayBrush" Color="{DynamicResource CommonDarkGrayColor}" />
    <SolidColorBrush x:Key="CommonGrayBrush" Color="{DynamicResource CommonGrayColor}" />
    <SolidColorBrush x:Key="CommonLightGrayBrush" Color="{DynamicResource CommonLightGrayColor}" />
    <SolidColorBrush x:Key="CommonWhiteBrush" Color="{DynamicResource CommonWhiteColor}" />

    <SolidColorBrush x:Key="CommonBrush" Color="{DynamicResource CommonColor}" />
    <SolidColorBrush x:Key="CommonBlueBrush" Color="{DynamicResource CommonBlueColor}" />
    <SolidColorBrush x:Key="CommonGreenBrush" Color="{DynamicResource CommonGreenColor}" />
    <SolidColorBrush x:Key="CommonYellowBrush" Color="{DynamicResource CommonYellowColor}" />
    <SolidColorBrush x:Key="CommonRedBrush" Color="{DynamicResource CommonRedColor}" />
    <SolidColorBrush x:Key="CommonPurpleBrush" Color="{DynamicResource CommonPurpleColor}" />
    <SolidColorBrush x:Key="CommonOrangeBrush" Color="{DynamicResource CommonOrangeColor}" />
    <SolidColorBrush x:Key="CommonCyanBrush" Color="{DynamicResource CommonCyanColor}" />
    <SolidColorBrush x:Key="CommonPinkBrush" Color="{DynamicResource CommonPinkColor}" />

    <SolidColorBrush x:Key="CommonBlueStrongBrush" Color="{StaticResource CommonBlueStrongColor}" />
    <SolidColorBrush x:Key="CommonGreenStrongBrush" Color="{StaticResource CommonGreenStrongColor}" />
    <SolidColorBrush x:Key="CommonYellowStrongBrush" Color="{StaticResource CommonYellowStrongColor}" />
    <SolidColorBrush x:Key="CommonPurpleStrongBrush" Color="{StaticResource CommonPurpleStrongColor}" />
    <SolidColorBrush x:Key="CommonOrangeStrongBrush" Color="{StaticResource CommonOrangeStrongColor}" />
    <SolidColorBrush x:Key="CommonCyanStrongBrush" Color="{StaticResource CommonCyanStrongColor}" />
    <SolidColorBrush x:Key="CommonPinkStrongBrush" Color="{StaticResource CommonPinkStrongColor}" />
    <SolidColorBrush x:Key="CommonRedStrongBrush" Color="{StaticResource CommonRedStrongColor}" />

    <SolidColorBrush x:Key="CommonBlueEdgeBrush" Color="{StaticResource CommonBlueEdgeColor}" />
    <SolidColorBrush x:Key="CommonGreenEdgeBrush" Color="{StaticResource CommonGreenEdgeColor}" />
    <SolidColorBrush x:Key="CommonYellowEdgeBrush" Color="{StaticResource CommonYellowEdgeColor}" />
    <SolidColorBrush x:Key="CommonRedEdgeBrush" Color="{StaticResource CommonRedEdgeColor}" />
    <SolidColorBrush x:Key="CommonPurpleEdgeBrush" Color="{StaticResource CommonPurpleEdgeColor}" />
    <SolidColorBrush x:Key="CommonOrangeEdgeBrush" Color="{StaticResource CommonOrangeEdgeColor}" />
    <SolidColorBrush x:Key="CommonCyanEdgeBrush" Color="{StaticResource CommonCyanEdgeColor}" />
    <SolidColorBrush x:Key="CommonPinkEdgeBrush" Color="{StaticResource CommonPinkEdgeColor}" />

    <SolidColorBrush
        x:Key="OnSurfaceDividerOnDarkBrush"
        Opacity="0.12"
        Color="{DynamicResource CommonWhiteColor}" />
    <SolidColorBrush
        x:Key="OnSurfaceDividerOnLightBrush"
        Opacity="0.12"
        Color="{DynamicResource CommonBlackColor}" />

    <SolidColorBrush
        x:Key="OnSurfaceCardStrokeOnDarkBrush"
        Opacity="0.16"
        Color="{DynamicResource CommonWhiteColor}" />
    <SolidColorBrush
        x:Key="OnSurfaceCardStrokeOnLightBrush"
        Opacity="0.16"
        Color="{DynamicResource CommonBlackColor}" />

    <LinearGradientBrush x:Key="HairlineTwoToneBrush" Opacity="1" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{DynamicResource CommonWhiteColor}" />
        <GradientStop Offset="1" Color="{DynamicResource CommonBlackColor}" />
    </LinearGradientBrush>
    <Color x:Key="TextPrimaryColor">#121212</Color>
    <Color x:Key="TextSecondaryColor">#4D4D4D</Color>
    <Color x:Key="AccentColor">#047AF7</Color>
    <Color x:Key="AccentTextColor">#0057D6</Color>
    <Color x:Key="FocusRingColor">#0057D6</Color>
    <Color x:Key="BorderSubtleColor">#D0D0D0</Color>
    <Color x:Key="SurfaceHoverColor">#E6E6E6</Color>
    <Color x:Key="SurfaceSelectedColor">#0057D6</Color>
    <Color x:Key="TextOnSelectedColor">#FFFFFF</Color>
    <Color x:Key="CaptionCloseHoverColor">#C42B1C</Color>
    <Color x:Key="CaptionCloseHoverGlyphColor">#FFFFFF</Color>
    <Color x:Key="SurfacePillSelectedColor">#DCDCDC</Color>
    <Color x:Key="SurfacePillSelectedBorderColor">#DCDCDC</Color>
    <Color x:Key="BorderStrongColor">#8A8A8A</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="TextOnSelectedBrush" Color="{StaticResource TextOnSelectedColor}" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{StaticResource CaptionCloseHoverColor}" />
    <SolidColorBrush x:Key="CaptionCloseHoverGlyphBrush" Color="{StaticResource CaptionCloseHoverGlyphColor}" />
    <SolidColorBrush x:Key="SurfacePillSelectedBrush" Color="{StaticResource SurfacePillSelectedColor}" />
    <SolidColorBrush x:Key="SurfacePillSelectedBorderBrush" Color="{StaticResource SurfacePillSelectedBorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <sys:Double x:Key="TimelineInactiveBarOpacity">1</sys:Double>
</ResourceDictionary>