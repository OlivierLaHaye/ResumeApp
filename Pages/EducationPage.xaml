<UserControl
    x:Class="ResumeApp.Pages.EducationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="mEducationPageRoot"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <Style
            x:Key="EducationMetaTextBlockStyle"
            BasedOn="{StaticResource PageBodyTextBlockStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="mEducationScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
        <Grid x:Name="mEducationContentHostGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1400" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="mEducationLayoutRoot" HorizontalAlignment="Stretch" Style="{StaticResource PageContentPanelStyle}">
                <StackPanel x:Name="mEducationHeaderStackPanel" Orientation="Vertical">
                    <TextBlock
                        x:Name="mEducationTitleTextBlock"
                        Style="{StaticResource PageTitleTextBlockStyle}"
                        Text="{Binding PageTitleText}" />
                    <TextBlock
                        x:Name="mEducationSubtitleTextBlock"
                        Style="{StaticResource PageSubtitleTextBlockStyle}"
                        Text="{Binding PageSubtitleText}" />
                </StackPanel>

                <ItemsControl
                    x:Name="mEducationItemsControl"
                    Focusable="False"
                    ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="mEducationItemBorder" Style="{StaticResource ContentGroupBorderStyle}">
                                <StackPanel x:Name="mEducationItemStackPanel" Orientation="Vertical">
                                    <TextBlock
                                        x:Name="mEducationItemTitleTextBlock"
                                        Margin="0,0,0,4"
                                        Style="{StaticResource PageSectionTitleTextBlockStyle}"
                                        Text="{Binding TitleText}" />

                                    <TextBlock
                                        x:Name="mEducationItemLocationDatesTextBlock"
                                        Style="{StaticResource EducationMetaTextBlockStyle}"
                                        Text="{Binding LocationDatesText}" />

                                    <TextBlock
                                        x:Name="mEducationItemNotesTextBlock"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource PageBodyTextBlockStyle}"
                                        Text="{Binding NotesText}"
                                        Visibility="{Binding HasNotes, Converter={StaticResource BoolToCollapseConverter}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
