<UserControl
    x:Class="ResumeApp.Pages.SkillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="clr-namespace:ResumeApp.AttachedProperties"
    x:Name="mSkillsPageRoot"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <UserControl.Resources>
        <Style x:Key="SkillSectionsItemsControlStyle" TargetType="{x:Type ItemsControl}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,-16,0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="mSkillSectionsRegularUniformGrid" Columns="2" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (attachedProperties:AdaptiveLayout.SizeClass), RelativeSource={RelativeSource Self}}" Value="Compact">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <UniformGrid x:Name="mSkillSectionsCompactUniformGrid" Columns="1" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding (attachedProperties:AdaptiveLayout.SizeClass), RelativeSource={RelativeSource Self}}" Value="Wide">
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <UniformGrid x:Name="mSkillSectionsWideUniformGrid" Columns="3" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="mSkillsScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
        <Grid x:Name="mSkillsContentHostGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1400" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="mSkillsLayoutRoot" HorizontalAlignment="Stretch" Style="{StaticResource PageContentPanelStyle}">
                <StackPanel x:Name="mSkillsHeaderStackPanel" Orientation="Vertical">
                    <TextBlock
                        x:Name="mSkillsTitleTextBlock"
                        Style="{StaticResource PageTitleTextBlockStyle}"
                        Text="{Binding PageTitleText}" />
                    <TextBlock
                        x:Name="mSkillsSubtitleTextBlock"
                        Style="{StaticResource PageSubtitleTextBlockStyle}"
                        Text="{Binding PageSubtitleText}" />
                </StackPanel>

                <ItemsControl
                    x:Name="mSkillSectionsItemsControl"
                    ItemsSource="{Binding Sections}"
                    Style="{StaticResource SkillSectionsItemsControlStyle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="mSkillSectionBorder"
                                Margin="0,0,16,16"
                                Style="{StaticResource ContentGroupBorderStyle}">
                                <StackPanel x:Name="mSkillSectionStackPanel" Orientation="Vertical">
                                    <TextBlock
                                        x:Name="mSkillSectionTitleTextBlock"
                                        Margin="0,0,0,12"
                                        Style="{StaticResource PageSectionTitleTextBlockStyle}"
                                        Text="{Binding TitleText}" />

                                    <ItemsControl
                                        x:Name="mSkillChipsItemsControl"
                                        Focusable="False"
                                        ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel x:Name="mSkillWrapPanel" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="mSkillChipBorder" Style="{StaticResource ChipBorderStyle}">
                                                    <TextBlock
                                                        x:Name="mSkillChipTextBlock"
                                                        Style="{StaticResource ChipTextBlockStyle}"
                                                        Text="{Binding DisplayText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
